# Paste the token from @BotFather here, never into a public chat.
TELEGRAM_BOT_TOKEN=
# Admin ID. Only this user can run /adduser, /removeuser and /users.
TELEGRAM_ALLOWED_USER_ID=
# Optional persistent allowlist file; default is data/authorized-users.json.
# On hosted servers, point this at a persistent disk to survive redeployments.
ACCESS_STORE_PATH=
# Daily activity JSONL files. Use a persistent disk path on hosted servers.
# Default: data/activity. Only admin can read them through /log.
ACTIVITY_LOG_DIR=
# false lets you watch Chromium while the bot runs.
HEADLESS=true
# Use your existing Microsoft Edge. Set chrome to use existing Google Chrome.
BROWSER_CHANNEL=msedge
# Local PC: polling. Render Free Web Service: webhook.
BOT_MODE=polling
# Experimental OTR modules. Set true when explicitly enabling OTR.
ENABLE_OTR=false
