# Paste the token from @BotFather here, never into a public chat.
TELEGRAM_BOT_TOKEN=
# Leave blank for initial /id setup, then enter your numeric Telegram user ID.
TELEGRAM_ALLOWED_USER_ID=
# false lets you watch Chromium while the bot runs.
HEADLESS=true
# Use your existing Microsoft Edge. Set chrome to use existing Google Chrome.
BROWSER_CHANNEL=msedge
# Local PC: polling. Render Free Web Service: webhook.
BOT_MODE=polling
